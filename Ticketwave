<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>TicketWave</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      color: white;
      font-family: Arial, sans-serif;
      background-color: #121212;
    }

    header {
      background-image: url(https://img.freepik.com/free-vector/gradient-abstract-wireframe-background_23-2149009903.jpg?t=st=1746052384~exp=1746055984~hmac=25b36798735f30a1bdf33b5ee78e9bdb7babd4e5753142ddc6dde8c606a13ecd&w=996);
      background-size: cover;
      background-position: center;
      height: 100vh;
      position: relative;
    }

    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(0, 0, 0, 0.6);
      padding: 20px 40px;
      position: absolute;
      width: 100%;
      top: 0;
      z-index: 100;
    }

    nav .logo {
      font-size: 30px;
      font-weight: bold;
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 25px;
    }

    nav a {
      color: white;
      text-decoration: none;
      font-size: 20px;
    }

    nav a:hover {
      color: #fdd835;
    }

    .hero {
      height: 100%;
      background: rgba(0, 0, 0, 0.6);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 0 20px;
    }

    .hero h1 {
      font-size: 45px;
      margin-bottom: 20px;
    }

    .hero p {
      font-size: 20px;
      margin-bottom: 30px;
      max-width: 600px;
    }

    .hero button {
      background: #fdd835;
      border: none;
      padding: 12px 25px;
      font-size: 18px;
      color: #333;
      border-radius: 5px;
      cursor: pointer;
    }

    .hero button:hover {
      background: #fbc02d;
    }

    section {
      padding: 80px 20px;
      text-align: center;
    }

    section h2 {
      font-size: 35px;
      margin-bottom: 20px;
      color: #fdd835;
    }

    section p {
      font-size: 18px;
      max-width: 800px;
      margin: 0 auto;
      line-height: 1.6;
    }

    .menu-toggle {
      display: none;
      cursor: pointer;
    }

    .menu-toggle span {
      display: block;
      height: 3px;
      width: 25px;
      background: white;
      margin: 5px 0;
    }

    @media (max-width: 768px) {
      nav ul {
        flex-direction: column;
        background: rgba(0, 0, 0, 0.95);
        position: absolute;
        top: 70px;
        left: 0;
        width: 100%;
        display: none;
      }

      nav ul.open {
        display: flex;
      }

      .menu-toggle {
        display: block;
      }

      nav ul li {
        padding: 15px;
        text-align: center;
        width: 100%;
      }
    }

  </style>
</head>

<body>

  <header>
    <nav>
      <div class="logo">🎫 TicketWave</div>
      <div class="menu-toggle" onclick="toggleMenu()">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <ul id="menu">
        <li><a href="#home">Home</a></li>
        <li><a href="#events">Events</a></li>
        <li><a href="#pricing">Pricing</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>

    <div class="hero" id="home">
      <h1>Book Your Tickets Online</h1>
      <p>Find and book tickets for concerts, sports, cinema, and more all in one place with TicketWave.</p>
      <button onclick="document.getElementById('events').scrollIntoView({behavior: 'smooth'})">Book Now</button>
    </div>
  </header>

  <section id="events">
    <h2>Upcoming Events</h2>
    <p>Stay up to date with the hottest events happening around you. From live concerts to blockbuster movie premieres, we've got your next outing covered!</p>
  </section>

  <section id="pricing">
    <h2>Pricing Plans</h2>
    <p>Choose the ticket that fits your budget. Whether it's general admission or VIP, TicketWave offers competitive prices and exclusive deals for all categories.</p>
  </section>

  <section id="contact">
    <h2>Contact Us</h2>
    <p>Have questions? Reach out to our support team any time. We're here to help you with bookings, refunds, or event information.</p>
  </section>

  <script>
    function toggleMenu() {
      document.getElementById('menu').classList.toggle('open');
    }

    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        document.querySelector(this.getAttribute('href')).scrollIntoView({
          behavior: 'smooth'
        });
      });
    });
  </script>

</body>
</html>
