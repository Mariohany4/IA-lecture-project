<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title> Online Courses</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body, html { height: 100%; color: white; }

    header {
      background-image: url(Image3.jpg);
      background-size: cover;
      background-position: center;
      height: 100vh;
      position: relative;
    }

    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(0, 0, 0, 0.7);
      padding: 20px 30px;
      position: absolute;
      width: 100%;
      top: 0;
      z-index: 100;
    }

    nav .logo {
      font-size: 30px;
      font-weight: bold;
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 20px;
    }

    nav a {
      color: white;
      text-decoration: none;
      font-size: 18px;
    }

    nav a:hover {
      color: #00e5ff;
    }

    .menu-toggle {
      display: none;
      cursor: pointer;
    }

    .menu-toggle span {
      display: block;
      height: 3px;
      width: 25px;
      background: white;
      margin: 5px 0;
    }

    .hero {
      height: 100%;
      background: rgba(0, 0, 0, 0.6);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 0 20px;
    }

    .hero h1 {
      font-size: 50px;
      margin-bottom: 20px;
    }

    .hero p {
      font-size: 20px;
      max-width: 600px;
      margin-bottom: 30px;
      line-height: 1.5;
    }

    .hero button {
      background: #00e5ff;
      border: none;
      padding: 12px 25px;
      font-size: 18px;
      color: #000;
      border-radius: 5px;
      cursor: pointer;
    }

    .hero button:hover {
      background: #00bcd4;
    }

    @media (max-width: 768px) {
      nav ul {
        flex-direction: column;
        background: rgba(0, 0, 0, 0.95);
        position: absolute;
        top: 70px;
        left: 0;
        width: 100%;
        display: none;
      }

      nav ul.open {
        display: flex;
      }

      .menu-toggle {
        display: block;
      }
    }
  </style>
</head>
<body>

  <header>
    <nav>
      <div class="logo">Online Courses</div>
      <div class="menu-toggle">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <ul id="menu">
        <li><a href="#">Home</a></li>
        <li><a href="#">Courses</a></li>
        <li><a href="#">Categories</a></li>
        <li><a href="#">Contact</a></li>
      </ul>
    </nav>

    <div class="hero">
      <h1>Start Learning Today</h1>
      <p>Explore top-rated online courses in programming, design, business, and more.  
         Learn from experts at your own pace anywhere, anytime.</p>
      <button>Browse Courses</button>
    </div>
  </header>

  <script>
    function toggleMenu() {
      document.getElementById('menu').classList.toggle('open');
    }
  </script>

</body>
</html>
